.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Docker
*.pid

# Claude Code local state
.claude/

# Local database dumps (Issue 057). Never committed: they contain real local
# data and can be large.
backups/
