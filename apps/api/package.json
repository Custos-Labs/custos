{
  "name": "@verixa/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./composition-root": {
      "types": "./dist/composition-root.d.ts",
      "default": "./dist/composition-root.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@verixa/audit": "workspace:*",
    "@verixa/authorization": "workspace:*",
    "@verixa/config": "workspace:*",
    "@verixa/credentials": "workspace:*",
    "@verixa/database": "workspace:*",
    "@verixa/identity": "workspace:*",
    "@verixa/mfa": "workspace:*",
    "@verixa/sessions": "workspace:*",
    "@verixa/shared-kernel": "workspace:*",
    "@verixa/stellar-anchor": "workspace:*",
    "fastify": "^5.12.1",
    "ioredis": "^5.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.6",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
