    "vitest": "^3.2.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./infrastructure/adapters/noop-rate-limiter.js": {
      "types": "./dist/infrastructure/adapters/noop-rate-limiter.d.ts",
