{
  "name": "@verixa/audit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "verify-chain": "tsx infrastructure/cli/verify-chain.ts",
    "demo": "pnpm --filter @verixa/audit^... run build && tsx scripts/anchor-demo.ts"
  },
  "dependencies": {
    "@verixa/database": "workspace:*",
    "@verixa/shared-kernel": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "@types/node": "^26.6.4",
    "@verixa/stellar-anchor": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
